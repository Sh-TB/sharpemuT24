# ==============================================================================
# SharpEmu .gitignore
# ==============================================================================
# Rule of thumb: source only. No build outputs, no binaries, no game files,
# no user-local state. Anything that can be regenerated by `dotnet build` or
# fetched by the build scripts must NOT be committed.
# ==============================================================================

# -----------------------------------------------------------------------------
# .NET build output (the BIG one — this was bloating the release archive)
# -----------------------------------------------------------------------------
**/bin/
**/obj/
artifacts/
[Bb]in/
[Oo]bj/
*.dll
*.exe
*.so
*.dylib
*.dll.config
*.pdb
*.exp
*.lib
*.a

# Single-file host bundles
singlefilehost
singlefilehost.exe

# NuGet package restore
*.nupkg
*.snupkg
.nuget/
.packages/
packages/
localnuget/

# Lock files used for local dev only (keep packages.lock.json if you publish them)
# Uncomment to ignore:
#**/packages.lock.json

# -----------------------------------------------------------------------------
# IDE / editor state
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.swp
*~
.DS_Store

# -----------------------------------------------------------------------------
# Test results / coverage
# -----------------------------------------------------------------------------
[Tt]est[Rr]esult/
[Bb]uild[Ll]og/
*.coverage
*.coveragexml
coverage/
TestResults/
trx/

# -----------------------------------------------------------------------------
# Runtime logs and dumps (large, machine-specific, regenerable)
# -----------------------------------------------------------------------------
logs/
*.log
*.bmp
*.ppm
*.png
!assets/images/*.png
!docs/**/*.png
*.dmp
*.crash
SharpEmu/diagnostics/

# -----------------------------------------------------------------------------
# Generated symbol/name tables (download or regenerate at build time)
# -----------------------------------------------------------------------------
# ps5_names.txt is 11 MB of generated symbol names — fetched by scripts.
# Keep it ignored in git; release assets can carry a copy if needed.
scripts/ps5_names.txt

# -----------------------------------------------------------------------------
# Game files, ROMs, keys, firmware — NEVER commit
# -----------------------------------------------------------------------------
eboot.bin
eboot*.bin
*.prx
*.sprx
*.self
*.pkg
*.pup
*.bin
!**/testdata/**/*.bin
sce_sys/
sce_module/
Media/
Data/
Resources/
*.assets
*.resS
*.bundle
*.bfdb
*.ags

# -----------------------------------------------------------------------------
# Local development scratch
# -----------------------------------------------------------------------------
*.tmp
*.bak
*.orig
scratch/
tmp/
local/

# -----------------------------------------------------------------------------
# OS-specific junk
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
.env
.env.local
*.key
*.pem
secrets.json
