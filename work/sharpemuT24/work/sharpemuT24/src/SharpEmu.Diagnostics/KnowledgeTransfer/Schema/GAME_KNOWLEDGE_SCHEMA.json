{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Knowledge Transfer",
  "type": "object",
  "required": ["titleId", "engine", "currentState", "bootProgress"],
  "properties": {
    "titleId": { "type": "string" },
    "engine": { "type": "string", "enum": ["Unity/IL2CPP", "Native C++", "Unreal", "Unknown"] },
    "currentState": { "type": "string" },
    "bootProgress": { "type": "integer", "minimum": 0, "maximum": 100 },
    "firstFrame": { "type": "boolean" },
    "videoOut": { "type": "boolean" },
    "blocker": { "type": "string" },
    "fixedNids": { "type": "array", "items": { "type": "string" } },
    "unresolvedNids": { "type": "array", "items": { "type": "string" } },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "commit": { "type": "string" },
          "change": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "nextAction": { "type": "string" },
    "reproductionCommand": { "type": "string" },
    "confidence": { "type": "string", "enum": ["Low", "Medium", "High", "N/A"] }
  }
}
